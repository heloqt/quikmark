#include "wx/msw/wx.rc"
#include "litemark/Version.h"

1 VERSIONINFO
FILEVERSION LITEMARK_VERSION_MAJOR,LITEMARK_VERSION_MINOR,LITEMARK_VERSION_PATCH,LITEMARK_VERSION_BUILD
PRODUCTVERSION LITEMARK_VERSION_MAJOR,LITEMARK_VERSION_MINOR,LITEMARK_VERSION_PATCH,LITEMARK_VERSION_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QuikMark\0"
            VALUE "FileDescription", "QuikMark Markdown Reader\0"
            VALUE "FileVersion", LITEMARK_VERSION_RESOURCE_STRING
            VALUE "InternalName", "QuikMark\0"
            VALUE "OriginalFilename", "quikmark.exe\0"
            VALUE "ProductName", "QuikMark\0"
            VALUE "ProductVersion", LITEMARK_VERSION_RESOURCE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
