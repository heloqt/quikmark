<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="QuikMark"
    Manufacturer="QuikMark"
    Version="$(var.ProductVersion)"
    Language="2052"
    Codepage="65001"
    UpgradeCode="E4F16B33-A6D1-44AE-8A96-E6C4A6AF5CA8"
    Scope="perUser"
    Compressed="yes"
    InstallerVersion="500">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="已安装更新版本的 QuikMark。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="轻量、原生的只读 Markdown 阅读器" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="QuikMark">
          <Directory Id="LocaleFolder" Name="locale">
            <Directory Id="ChineseLocaleFolder" Name="zh_CN">
              <Directory Id="ChineseLcMessagesFolder" Name="LC_MESSAGES" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="QuikMark" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="MainComponents">
      <Component Id="MainFiles" Directory="INSTALLFOLDER"
                 Guid="2EB6D388-5295-47DE-A570-9C5AE54FF118">
        <File Id="MainExecutable"
              Source="$(var.SourceExe)"
              Name="quikmark.exe" />
        <File Id="LicenseFile"
              Source="$(var.LicenseFile)"
              Name="LICENSE" />
        <File Id="ThirdPartyNotices"
              Source="$(var.NoticeFile)"
              Name="THIRD_PARTY_NOTICES.md" />
        <File Id="UsageFile"
              Source="$(var.UsageFile)"
              Name="使用说明.md" />
        <File Id="UsageEnglishFile"
              Source="$(var.UsageEnglishFile)"
              Name="Usage.md" />
        <RemoveFolder Id="RemoveInstallFolder"
                      Directory="INSTALLFOLDER"
                      On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder"
                      Directory="ProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\QuikMark"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcuts"
                 Directory="ApplicationProgramsFolder"
                 Guid="A3E3FEC8-1F11-45D3-8664-7F66D26FDCCD">
        <Shortcut Id="StartMenuApp"
                  Name="QuikMark"
                  Description="QuikMark Markdown 阅读器"
                  Target="[INSTALLFOLDER]quikmark.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="StartMenuUsage"
                  Name="使用说明"
                  Description="打开 QuikMark 使用说明"
                  Target="[INSTALLFOLDER]quikmark.exe"
                  Arguments="&quot;[INSTALLFOLDER]使用说明.md&quot;"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="StartMenuUninstall"
                  Name="卸载 QuikMark"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\QuikMark"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="ChineseLocale"
                 Directory="ChineseLcMessagesFolder"
                 Guid="BBA485CE-2D11-47A0-A597-1B41577E7397">
        <File Id="ChineseCatalog"
              Source="$(var.LocaleDir)\zh_CN\LC_MESSAGES\quikmark.mo"
              Name="quikmark.mo" />
        <RemoveFolder Id="RemoveChineseLcMessages"
                      Directory="ChineseLcMessagesFolder"
                      On="uninstall" />
        <RemoveFolder Id="RemoveChineseLocale"
                      Directory="ChineseLocaleFolder"
                      On="uninstall" />
        <RemoveFolder Id="RemoveLocaleFolder"
                      Directory="LocaleFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\QuikMark"
                       Name="ChineseLocale"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature"
             Title="QuikMark 程序"
             Description="安装 QuikMark、许可证、第三方声明、使用说明和开始菜单快捷方式。"
             Level="1"
             AllowAbsent="no">
      <ComponentGroupRef Id="MainComponents" />
    </Feature>

    <Feature Id="DesktopShortcutFeature"
             Title="桌面快捷方式"
             Description="在当前用户桌面创建 QuikMark 快捷方式。"
             Level="1"
             AllowAbsent="yes">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <Feature Id="FileAssociationFeature"
             Title="Markdown 文件关联"
             Description="使用 QuikMark 打开 .md 和 .markdown 文件。"
             Level="1"
             AllowAbsent="yes">
      <ComponentRef Id="FileAssociationComponent" />
    </Feature>

    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder"
               Guid="E36F8B79-C498-448C-B562-4B850D5CEE7F">
      <Shortcut Id="DesktopAppShortcut"
                Name="QuikMark"
                Description="QuikMark Markdown 阅读器"
                Target="[INSTALLFOLDER]quikmark.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\QuikMark"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="FileAssociationComponent"
               Directory="INSTALLFOLDER"
               Guid="9FC01E4E-C9D9-4D33-8127-5C63B092CF35">
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\.md"
                     Type="string"
                     Value="QuikMark.Markdown" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\.markdown"
                     Type="string"
                     Value="QuikMark.Markdown" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\QuikMark.Markdown"
                     Type="string"
                     Value="Markdown Document" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\QuikMark.Markdown\DefaultIcon"
                     Type="string"
                     Value="[INSTALLFOLDER]quikmark.exe,0" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\QuikMark.Markdown\shell\open\command"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]quikmark.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\Applications\quikmark.exe"
                     Name="FriendlyAppName"
                     Type="string"
                     Value="QuikMark" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\Applications\quikmark.exe\shell\open\command"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]quikmark.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\Applications\quikmark.exe\SupportedTypes"
                     Name=".md"
                     Type="string"
                     Value="" />
      <RegistryValue Root="HKCU"
                     Key="Software\Classes\Applications\quikmark.exe\SupportedTypes"
                     Name=".markdown"
                     Type="string"
                     Value="" />
      <RegistryValue Root="HKCU"
                     Key="Software\QuikMark"
                     Name="FileAssociations"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Package>
</Wix>
